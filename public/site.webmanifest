{
  "name": "Nugmail",
  "short_name": "Nugmail",
  "description": "A focused Gmail client with notes, goals, and relevance scoring.",
  "start_url": "/inbox",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f8fc",
